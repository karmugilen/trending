# Copy to keystore.properties (gitignored) and fill in. Paths are relative to the repo root.
# Create a key once with:
#   keytool -genkeypair -v -keystore ~/keys/trending-release.jks -alias trending \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=/home/you/keys/trending-release.jks
storePassword=
keyAlias=trending
keyPassword=
